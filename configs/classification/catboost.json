{
  "model_file": "models/classification/catboost_gate_a/gate_a_high_alpha_classifier.cbm",
  "feature_columns": [
    "natoms",
    "nspecies",
    "a_len",
    "b_len",
    "thickness",
    "gamma_angle",
    "area_2d",
    "area_per_atom",
    "buckling",
    "nn_dist_mean",
    "nn_dist_std",
    "nn_dist_min",
    "nn_dist_max",
    "bond_count",
    "bond_len_mean",
    "bond_len_std",
    "bond_len_min",
    "bond_len_max",
    "coord_mean",
    "coord_std",
    "coord_min",
    "coord_max",
    "bond_angle_mean",
    "bond_angle_std",
    "bond_angle_min",
    "bond_angle_max",
    "mass_avg",
    "mass_min",
    "mass_max",
    "mass_var",
    "atomic_number_mean",
    "atomic_number_min",
    "atomic_number_max",
    "atomic_number_var",
    "light_element_fraction",
    "heavy_element_fraction",
    "en_atom_mean",
    "en_atom_std",
    "en_diff_mean",
    "en_diff_max",
    "en_diff_var",
    "is_ionic_like",
    "group_mean",
    "group_std",
    "valence_proxy_mean",
    "valence_proxy_max",
    "valence_proxy_var",
    "gap_pbe",
    "alphax_el",
    "alphay_el",
    "alphaz_el",
    "alpha_el_mean_diag",
    "layergroup",
    "pointgroup",
    "has_inversion_symmetry",
    "is_janus_like",
    "has_out_of_plane_dipole"
  ],
  "categorical_features": [
    "layergroup",
    "pointgroup"
  ],
  "training": {
    "n_splits": 5,
    "params": {
      "loss_function": "Logloss",
      "eval_metric": "PRAUC",
      "iterations": 5000,
      "learning_rate": 0.03,
      "depth": 5,
      "l2_leaf_reg": 30.0,
      "random_strength": 5.0,
      "bagging_temperature": 0.5,
      "border_count": 128,
      "bootstrap_type": "Bayesian",
      "random_seed": 42,
      "task_type": "GPU",
      "verbose": 100,
      "allow_writing_files": false,
      "auto_class_weights": "Balanced"
    }
  },
  "deployment": "The selected probability fusion and decision threshold are defined in models/classification/weighted_fusion/fusion_classifier_manifest.json."
}
